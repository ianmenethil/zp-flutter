# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
# Local Claude Code state stays private — EXCEPT .claude/skills/, which ships
# with the repo so a fresh clone gets the ZenPay demo-app builder skill.
.claude/*
!.claude/skills/
.story/
.agents/
zenpay_typescript/
# Environment variables
.env
.bak/

# Local TLS certs (mkcert) — generated per machine by scripts/bootstrap.ps1.
# localhost+2-key.pem is a private key and must never be committed.
*.pem

# Android App Link verification file — generated per machine by
# `dart run cli.dart --bootstrap` from the local debug keystore's SHA-256,
# which differs on every machine. Committing one machine's fingerprint makes
# the mobile checkout return fail silently for everyone else who clones.
example/backend/well_known/assetlinks.json

# Custom User Folders to ignore
.examples/
development/
zenpay_dart/example.bak/

# Generated by scripts/sync_package_examples.dart from example/backend and
# example/app — the single source of truth. Never hand-edit these; re-run
# the script instead. Required to exist on disk before publishing either
# package (dart pub publish reads whatever's actually there).
zenpay_dart/example/
zenpay_flutter/example/

# Local working notes — not part of the published repo.
/claude-code-skills-commands.md
/BACKLOG-PROPOSAL.md
# Downloaded test tooling (chromedriver) — binaries stay local.
scripts/tools/
# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

