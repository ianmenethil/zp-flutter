{
  // Fronts two Cloudflare Containers as one Worker — see src/index.ts, which
  // routes each request by path to whichever container owns it. Backend
  // (docker/cloudflare/Dockerfile.backend) serves /api/v1/*, /return,
  // /.well-known/*; frontend (docker/cloudflare/Dockerfile.frontend, nginx)
  // serves the built Flutter Web app for everything else. These are
  // Cloudflare-specific Dockerfiles, deliberately separate from
  // docker/local/ (used by docker/local/docker-compose.yml for local dev)
  // — the local ones need mkcert TLS + compose networking that don't apply
  // once Cloudflare's own edge is terminating HTTPS. Deploy with
  // `npm run cf:deploy` (needs Docker running locally and a Workers Paid
  // plan). Secrets (ZENPAY_*, TOKEN_SECRET, etc. from example/backend/.env)
  // are set separately via `wrangler secret put <NAME>`, not committed here.
  "name": "flutter-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "containers": [
    {
      "class_name": "ZenpayBackendContainer",
      "image": "./docker/cloudflare/Dockerfile.backend",
      // Both Dockerfiles COPY from repo-root paths (zenpay_dart/,
      // example/backend/, ...) — without this, Wrangler defaults the build
      // context to the Dockerfile's own directory, where none of those
      // paths exist, and every COPY fails "not found".
      "image_build_context": ".",
    },
    {
      "class_name": "ZenpayFrontendContainer",
      "image": "./docker/cloudflare/Dockerfile.frontend",
      "image_build_context": ".",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ZenpayBackendContainer",
        "name": "ZENPAY_BACKEND_CONTAINER",
      },
      {
        "class_name": "ZenpayFrontendContainer",
        "name": "ZENPAY_FRONTEND_CONTAINER",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ZenpayBackendContainer", "ZenpayFrontendContainer"],
    },
  ],
}
