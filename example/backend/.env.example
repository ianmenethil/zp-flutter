PORT=7000

# Public HTTPS address of THIS server. Everything ZenPay is told to call is
# derived from it:
#   redirectUrl = <PUBLIC_BASE_URL>/return
#   callbackUrl = <PUBLIC_BASE_URL>/api/v1/callbacks
#
# localhost works until you need a real payment: ZenPay's callback is
# server-to-server, so it cannot reach your machine. Expose port 7000 and
# paste the https URL here, e.g. `cloudflared tunnel --url http://localhost:7000`.
PUBLIC_BASE_URL=http://localhost:7000

# Named cloudflared tunnel token (`dart run cli.dart --tunnel`), from
# Cloudflare Zero Trust > Networks > Tunnels. Not used by --quick-tunnel,
# which needs no account/token at all.
CLOUDFLARE_TUNNEL_TOKEN=

# Origin the example app is served from, compared literally against the
# browser's Origin header for CORS.
ALLOWED_APP_ORIGIN=http://localhost:3000

# Must be HTTPS. The backend never accepts a return URL from the
# client, so this cannot be turned into an open redirect.
APP_RETURN_URI_WEB=https://localhost:3000/

# The full HCP Authorise endpoint, path included.
ZENPAY_HPP_ENDPOINT_URL=https://pay.sandbox.travelpay.com.au/Online/v5
ZENPAY_MERCHANT_CODE=
ZENPAY_API_KEY=

# Required for BOTH launch and callback verification. Never leave this
# backend: hashed into the SHA3-512 fingerprint, and used again to recompute
# a callback's ValidationCode.
ZENPAY_USERNAME=
ZENPAY_PASSWORD=

ZENPAY_ALLOWED_CHECKOUT_HOSTS=pay.sandbox.travelpay.com.au
CHECKOUT_STATUS_TTL_MINUTES=60

# Root secret every token type derives its signing key from (see
# lib/src/token_keys.dart): return/status tokens (createZpCallbackUrlToken)
# and checkout tokens each sign with their own derived key, not this value
# directly. At least 32 bytes, separate from the ZenPay password. Generate
# with: openssl rand -hex 32
#
# Rotating this value invalidates every outstanding checkoutToken and t token
# immediately — they're both short-lived, so that's expected, not a
# migration to plan around.
TOKEN_SECRET=

# Lifetime of a POST /api/v1/checkout/token capability. Short — it only needs
# to survive the gap before the client calls /checkout/exchange.
CHECKOUT_TOKEN_TTL_SECONDS=300

# Per-IP requests/minute on /checkout/token and /checkout/exchange — the
# anonymous checkout admission boundary.
CHECKOUT_RATE_LIMIT_PER_MINUTE=20

# reCAPTCHA Enterprise verification for POST /checkout/token — web clients
# only (mobile requests skip it entirely). Optional: leave all three empty to
# disable enforcement for local dev. All three are required together once set.
RECAPTCHA_PROJECT_NUMBER=
RECAPTCHA_SERVICE_ACCOUNT_JSON=
RECAPTCHA_SITE_KEY_WEB=

