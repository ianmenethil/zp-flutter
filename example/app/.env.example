# Demo app config. Copy to .env — used by all scripts/run-*.ps1.
#
# Must agree with example/backend/.env: the SDK compares the return URI exactly
# (scheme, host, port, path), and a mismatch is rejected rather than ignored.

# Where the example backend listens (backend/.env PORT).
# Android reaches it via `adb reverse tcp:7000` — run-android.ps1 does that.
BACKEND_BASE_URL=http://localhost:7000

# Hosts a checkout URL may point at (backend/.env ZENPAY_ALLOWED_CHECKOUT_HOSTS).
ALLOWED_CHECKOUT_HOSTS=pay.sandbox.travelpay.com.au

# Return targets. The app picks by platform, mirroring the backend, which sends
# web checkouts to APP_RETURN_URI_WEB and mobile ones to
# <PUBLIC_BASE_URL>/zenpay/app-return. https is mandatory for both.
APP_RETURN_URI_WEB=https://localhost:3000/

# Must be the public HTTPS host serving /.well-known/, NOT localhost: the OS
# fetches those files from the internet to verify the App Link. Use a tunnel —
#   cloudflared tunnel --url http://localhost:7000
APP_RETURN_URI_MOBILE=https://payments.example.com/zenpay/app-return
